{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 36,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/language"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/tailscale",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "tray",
        "clock"
    ],
    "hyprland/window": {
        "format": "Aktif Pencere: {}",
        "rewrite": {
            "(.*)Code(.*)": "Metin Editörü $1"
        },
        "separate-outputs": true
    },
    "hyprland/language": {
        "format": "Dil: {}",
        "format-tr": "🇹🇷",
        "format-en": "🇺🇸",
        "keyboard-name": "at-translated-set-2-keyboard"
    },
    "hyprland/workspaces": {
        "sort-by": "id",
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "active": "",
            "default": ""
        }
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% / CPU"
    },
    "memory": {
        "format": "{}% / RAM"
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "format-disconnected": "Disconnected ⚠"
    },
    "custom/tailscale": {
        "format": "{}",
        "exec": " tailscale ip --4",
        "interval": 5, 
        "on-click": "notify-send 'Tıklandı!'" 
    },
    "pulseaudio": {
        "scroll-step": 1,
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "headphones": "",
            "default": [
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    }
}